// Top failure reasons by frequency
// Dashboard: GenAI Operations - Top Failure Modes
// Shows the most common failure categories across evaluations

customMetrics
| where timestamp > ago(30d)
| where name == "drift_alert" or name == "evaluation_failure"
| extend failure_category = tostring(customDimensions["failure_category"])
| extend failure_reason = tostring(customDimensions["failure_reason"])
| extend prompt_version = tostring(customDimensions["prompt_version"])
| where isnotempty(failure_reason) or isnotempty(failure_category)
| extend category = coalesce(failure_category, failure_reason, "unspecified")
| summarize
    occurrence_count = count(),
    latest = max(timestamp),
    affected_versions = make_set(prompt_version)
    by category
| order by occurrence_count desc
| take 10
| project
    rank = row_number(),
    failure_category = category,
    occurrence_count,
    last_seen = latest,
    affected_prompt_versions = affected_versions
