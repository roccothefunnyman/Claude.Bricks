// Daily token consumption and estimated cost
// Dashboard: GenAI Operations - Token Usage and Cost
// Tracks input/output tokens and estimated USD cost per day

customMetrics
| where timestamp > ago(30d)
| where name in ("input_tokens", "output_tokens", "estimated_cost_usd")
| extend prompt_version = tostring(customDimensions["prompt_version"])
| extend model_version = tostring(customDimensions["model_version"])
| summarize
    total_value = sum(value),
    avg_value = avg(value),
    sample_count = count()
    by name, bin(timestamp, 1d), prompt_version, model_version
| pivot name, sum(total_value)
| project
    timestamp,
    prompt_version,
    model_version,
    input_tokens = coalesce(input_tokens, 0),
    output_tokens = coalesce(output_tokens, 0),
    total_tokens = coalesce(input_tokens, 0) + coalesce(output_tokens, 0),
    estimated_cost_usd = round(coalesce(estimated_cost_usd, 0), 4)
| order by timestamp asc
